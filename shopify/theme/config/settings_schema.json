[
  {
    "name": "theme_info",
    "theme_name": "Rizo Portal",
    "theme_author": "Rizo Apparel",
    "theme_version": "0.8.0",
    "theme_documentation_url": "https://rizo.store",
    "theme_support_url": "https://rizo.store"
  },
  {
    "name": "Brand system",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      },
      {
        "type": "color",
        "id": "color_ink",
        "label": "Ink",
        "default": "#090909"
      },
      {
        "type": "color",
        "id": "color_paper",
        "label": "Paper",
        "default": "#f4f0e8"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Rizo blue",
        "default": "#20bdf2"
      },
      {
        "type": "color",
        "id": "color_accent_2",
        "label": "Heat",
        "default": "#ff5d21"
      },
      {
        "type": "color",
        "id": "color_muted",
        "label": "Muted",
        "default": "#8d8d8d"
      },
      {
        "type": "range",
        "id": "radius",
        "label": "Corner radius",
        "min": 0,
        "max": 32,
        "step": 2,
        "default": 18,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "page_width",
        "label": "Page width",
        "min": 1080,
        "max": 1600,
        "step": 40,
        "default": 1240,
        "unit": "px"
      }
    ]
  },
  {
    "name": "Experience",
    "settings": [
      {
        "type": "select",
        "id": "motion_level",
        "label": "Motion level",
        "default": "balanced",
        "options": [
          {
            "value": "calm",
            "label": "Calm"
          },
          {
            "value": "balanced",
            "label": "Balanced"
          },
          {
            "value": "expressive",
            "label": "Expressive"
          }
        ]
      },
      {
        "type": "select",
        "id": "texture_level",
        "label": "Texture level",
        "default": "balanced",
        "options": [
          {
            "value": "calm",
            "label": "Calm"
          },
          {
            "value": "balanced",
            "label": "Balanced"
          },
          {
            "value": "expressive",
            "label": "Expressive"
          }
        ],
        "info": "Controls lightweight grain, registration marks, and tactile surfaces."
      },
      {
        "type": "checkbox",
        "id": "enable_sound",
        "label": "Show optional sound control",
        "default": false,
        "info": "Sound always starts off and only activates after a customer chooses it."
      },
      {
        "type": "checkbox",
        "id": "enable_install_guide",
        "label": "Show Home Screen install option",
        "default": false
      }
    ]
  },
  {
    "name": "Original signal",
    "settings": [
      {
        "type": "checkbox",
        "id": "heritage_mode",
        "label": "Enable original-site details",
        "default": true,
        "info": "Adds the date/time, catalog notation, and stripped-back archive details inspired by the original Rizo storefront."
      },
      {
        "type": "select",
        "id": "signal_clock_mode",
        "label": "Signal clock mode",
        "default": "archive",
        "options": [
          {
            "value": "archive",
            "label": "Original archive time"
          },
          {
            "value": "live",
            "label": "Live Pittsburgh time"
          }
        ]
      },
      {
        "type": "text",
        "id": "archive_date",
        "label": "Archive date",
        "default": "02/22/2023"
      },
      {
        "type": "text",
        "id": "archive_time",
        "label": "Archive time",
        "default": "2:22 PM"
      },
      {
        "type": "text",
        "id": "signal_timezone",
        "label": "Live clock timezone",
        "default": "America/New_York",
        "info": "Use an IANA timezone such as America/New_York."
      },
      {
        "type": "text",
        "id": "catalog_prefix",
        "label": "Catalog prefix",
        "default": "RZ"
      }
    ]
  },
  {
    "name": "Product signals",
    "settings": [
      {
        "type": "paragraph",
        "content": "Badge priority: SOLD OUT always wins. A custom.badge product metafield overrides automatic states except sold out."
      },
      {
        "type": "paragraph",
        "content": "Exact lowercase product tags: new-drop (or legacy just-entered), low-stock, restocked, event-exclusive, core-piece. Remove outdated tags when the state ends."
      },
      {
        "type": "range",
        "id": "low_stock_threshold",
        "label": "Automatic low-stock threshold",
        "min": 1,
        "max": 20,
        "step": 1,
        "default": 5,
        "info": "Applied only to tracked inventory that stops selling at zero. The low-stock tag can still force the badge."
      }
    ]
  },
  {
    "name": "World state",
    "settings": [
      {
        "type": "select",
        "id": "world_state",
        "label": "Current world state",
        "default": "quiet",
        "options": [
          {
            "value": "quiet",
            "label": "Quiet"
          },
          {
            "value": "teasing",
            "label": "Teasing"
          },
          {
            "value": "drop-incoming",
            "label": "Drop incoming"
          },
          {
            "value": "live",
            "label": "Live"
          },
          {
            "value": "sold-out",
            "label": "Sold out"
          },
          {
            "value": "event-mode",
            "label": "Event mode"
          }
        ]
      },
      {
        "type": "checkbox",
        "id": "show_world_state_in_header",
        "label": "Show state indicator in header",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "enable_mobile_shop_utility",
        "label": "Enable mobile bottom shop utility",
        "default": true
      },
      {
        "type": "range",
        "id": "free_shipping_threshold",
        "label": "Free shipping threshold",
        "min": 0,
        "max": 300,
        "step": 5,
        "default": 0,
        "unit": "$",
        "info": "Set to 0 to disable. Only enable when the offer is real."
      }
    ]
  }
]